# =============================
# AgroFácil — variables de entorno
# =============================
# Copiar este archivo a .env y completar.

# --- Backend ---
DATABASE_URL=postgresql://agrofacil:agrofacil_dev@localhost:5432/agrofacil
JWT_SECRET=cambiar-en-produccion-min-32-caracteres-aleatorios
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Anthropic — carga por voz/foto (Fase 9-10)
ANTHROPIC_API_KEY=

# Superadmin — se crea/actualiza al correr `npm run db:seed`.
# Si no se setean, el seed los saltea.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NOMBRE=Mateo

# Frontend público — base URL para armar links de activación en los emails.
# En dev: http://localhost:5173 — en prod: la URL de Railway/dominio.
APP_PUBLIC_URL=http://localhost:5173

# Resend — proveedor de email para invitaciones.
# Si está vacío, el EmailService loguea en lugar de enviar (modo dev).
RESEND_API_KEY=
# Dirección de origen. Debe ser un email del dominio verificado en Resend.
# Mientras no verifiques el dominio, usar el sandbox: "AgroFácil <onboarding@resend.dev>".
EMAIL_FROM=AgroFácil <soporte@agrofacilar.com>
# Cuando el destinatario haga "Responder", a qué email le llega.
EMAIL_REPLY_TO=soporte@agrofacilar.com

# --- Frontend (en frontend/.env) ---
# VITE_API_URL=http://localhost:3000/api/v1
