# =============================
# AgroFácil — variables de entorno
# =============================
# Copiar este archivo a .env y completar.

# --- Backend ---
DATABASE_URL=postgresql://agrofacil:agrofacil_dev@localhost:5432/agrofacil
JWT_SECRET=cambiar-en-produccion-min-32-caracteres-aleatorios
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Anthropic — carga por voz/foto (Fase 9-10)
ANTHROPIC_API_KEY=

