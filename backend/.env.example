DATABASE_URL=postgresql://agrofacil:agrofacil_dev@localhost:5432/agrofacil
JWT_SECRET=cambiar-en-produccion-min-32-caracteres-aleatorios
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# ─── Asistente IA (Groq · gpt-oss-20b) ────────────────────────
# Key gratis en https://console.groq.com/keys — sin costo con rate limits
# (30 req/min por defecto). Si está vacía, el asistente responde con un
# stub pero el resto de la app sigue funcionando.
GROQ_API_KEY=
# Opcional. Default openai/gpt-oss-20b (buen balance velocidad/calidad + tool use).
# Alternativas: openai/gpt-oss-120b (mejor calidad, más lento), qwen/qwen3.8-27b.
# Nota: los modelos Llama 3.x no están habilitados en el free tier del hackathon.
GROQ_MODEL=openai/gpt-oss-20b

# ─── Módulo tokenizadas (ledger) ──────────────────────────────
# `mock` (default): persistencia en Postgres + delays. `solana`: firma real
# contra devnet. Cambiar a solana en Railway solo cuando las envs de abajo
# estén completas — si están vacías, arranque falla.
LEDGER_IMPL=mock



# 64 hex chars = 32 bytes AES-256. Generar: `openssl rand -hex 32`.
# Si se pierde, todos los keypairs custodiales quedan inaccesibles.
WALLET_ENCRYPTION_KEY=

# Lamports que fondea al conectar cada wallet nueva. 20_000_000 = 0.02 SOL.
SOLANA_USER_FUND_LAMPORTS=20000000

# USDC de prueba (en micro-USDC) que se mintea al conectar. 10_000_000_000 = 10.000 USDC.
SOLANA_USER_TEST_USDC=10000000000
